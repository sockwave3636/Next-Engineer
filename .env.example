# Copy to .env (or .env.local) for local development, and add the same variables in
# Vercel -> Project -> Settings -> Environment Variables. Never commit real values.

# ---------------------------------------------------------------------------
# Public values (NEXT_PUBLIC_*). These end up in the browser bundle, which is
# expected: they identify the project but grant no access by themselves.
# ---------------------------------------------------------------------------

# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# The site's public address, used for canonical links and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Google AdSense publisher ID (ca-pub-...). Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Comma-separated owner/admin emails. Must match isOwner() in firestore.rules and storage.rules.
NEXT_PUBLIC_OWNER_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Razorpay -> Account & Settings -> API Keys (use rzp_test_ keys until you go live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks -> the secret you typed when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Copy client_email and private_key from the downloaded JSON file.
FIREBASE_CLIENT_EMAIL=
# Paste the whole key including the BEGIN/END lines, keeping the \n sequences, inside double quotes
FIREBASE_PRIVATE_KEY=""
# Optional overrides; default to the NEXT_PUBLIC_FIREBASE_* values above
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
