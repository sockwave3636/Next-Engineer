rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Keep in sync with OWNER_EMAILS in lib/owners.ts
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['aahabhisheksingh@gmail.com', 'adityanathncert@gmail.com'];
    }

    // Free study material: resources/{subjectId}/{file}. Like premium files, browsers can't
    // read these directly; students read them in the in-site viewer via /api/resources/view.
    match /resources/{allPaths=**} {
      allow read: if false;
      allow write: if isOwner();
    }

    // Blog images, videos and files
    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Mini project files (PDFs, zips, screenshots): server only. Buyers read the PDFs through
    // /api/projects/view and download the zip through a short-lived link from /api/projects/download.
    match /projects/{allPaths=**} {
      allow read, write: if false;
    }

    // Students' uploads awaiting a check: untrusted, so no browser can ever read or fetch them.
    // Owners see them only as byte ranges in the on-site reader, via /api/admin/contributions/view.
    match /submissions/{allPaths=**} {
      allow read, write: if false;
    }

    // Premium PDFs: no client can read them. Pass holders read them in the
    // in-site viewer, which streams byte ranges from /api/resources/view.
    match /premium/{allPaths=**} {
      allow read: if false;
      allow write: if isOwner();
    }
  }
}
